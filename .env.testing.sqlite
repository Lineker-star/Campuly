APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DEMO_MODE=false

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

DB_CONNECTION=sqlite
DB_DATABASE=database/testing.sqlite
DATABASE_URL=

TELESCOPE_ENABLED=false
# Tests throw the database away, so skip the disk syncs that make SQLite slow.
# (No DB_JOURNAL_MODE here: switching to WAL needs a lock a second test connection cannot get.)
DB_SYNCHRONOUS=off
DB_BUSY_TIMEOUT=10000
