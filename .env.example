APP_NAME=Campuly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
# Brand colour used by browsers and the installed app
APP_THEME_COLOR="#2E2CFC"
APP_CURRENCY=XAF

# A public demo only: resets every record hourly and refuses deletions.
DEMO_MODE=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=skuul
DB_USERNAME=sail
DB_PASSWORD=password
# PostgreSQL / Supabase: DB_CONNECTION=pgsql, DB_PORT=5432, DB_SSLMODE=require (see docs/DEPLOYMENT.md)
# DB_SSLMODE=prefer

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Unset, this is true only when APP_ENV=production.
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=laravel
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@campuly.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_ADDRESS="contact@campuly.com"
MAIL_REPLY_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible storage (Supabase Storage, R2, Spaces, MinIO): set FILESYSTEM_DISK=s3 and
# AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3 with AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_ENDPOINT=

LOGO_PATH="img/brand/campuly-mark.png"
# LOGO_FULL_PATH="img/brand/campuly-logo.png"
# LOGO_FULL_DARK_PATH="img/brand/campuly-logo-dark.png"
# FAVICON_PATH="favicon.ico"

#customize look and feel

# Monitoring and backups
MONITORING_SLOW_QUERY_MS=500
MONITORING_SLOW_REQUEST_QUERY_MS=2000
BACKUP_DISK=local
BACKUP_FILES_DISK=local
BACKUP_PATH=backups
BACKUP_MAX_AGE_HOURS=26
# Backups refuse to run without a key while BACKUP_REQUIRE_ENCRYPTION=true.
# Keep the key outside the backup storage.
BACKUP_KEY=
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MONTHS=12
BACKUP_REHEARSAL_CONNECTION=
BACKUP_REHEARSAL_PATH=restore-rehearsals
BACKUP_REHEARSAL_MAX_AGE_DAYS=7
# The rehearsal database must be isolated and disposable. Never use the production database.
# Unset, these three use the DB_HOST, DB_USERNAME, and DB_PASSWORD values.
# BACKUP_REHEARSAL_HOST=
BACKUP_REHEARSAL_DATABASE=campuly_rehearsal
# BACKUP_REHEARSAL_USERNAME=
# BACKUP_REHEARSAL_PASSWORD=

# Accounts
CHECK_EMAIL_DOMAINS=true
ACCOUNT_INVITATION_EXPIRY_HOURS=72

# Document printing: leave empty for the built-in renderer, or set browser or dompdf.
DOCUMENT_RENDERER=
BROWSER_RENDERER_URL=
BROWSER_RENDERER_TOKEN=
BROWSER_RENDERER_TIMEOUT=120

# Updates: the GitHub repository whose releases campuly:update installs.
# SKUUL_UPDATE_REPOSITORY is still read when this is unset.
CAMPULY_UPDATE_REPOSITORY=Lineker-star/Campuly

# Where the Documentation links in the header and sidebar lead.
CAMPULY_DOCS_URL=https://github.com/Lineker-star/Campuly/tree/main/docs

# Release readiness
RELEASE_RPO_HOURS=24
RELEASE_RTO_MINUTES=240
RELEASE_RETENTION_POLICY_VERSION=2026-08
RELEASE_RETENTION_POLICY_APPROVED=false

# Container (Dockerfile): run migrations on boot for exactly one service
RUN_MIGRATIONS=false
